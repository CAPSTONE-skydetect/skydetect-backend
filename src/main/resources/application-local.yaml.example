# 로컬 전용 설정 예시 파일.
#
# 사용법
#   1. 이 파일을 같은 디렉토리에 application-local.yaml 로 복사한다
#   2. 값을 자신의 환경에 맞게 채운다
#
# application-local.yaml 은 커밋되지 않는다.
# 실제 접속 정보를 이 예시 파일에 적지 마라.

spring:
  datasource:
    username: skydetect
    password: 여기에_비밀번호

skydetect:
  auth:
    # 최초 기동 시 이 계정을 만든다. 이미 있으면 아무것도 하지 않는다.
    # 회원가입 API 가 없으므로 이 설정이 없으면 로그인할 계정 자체가 없다.
    initial-operator:
      username: operator
      password: 여기에_운영자_비밀번호

    # 실제 메일 발송을 시험할 때만 켠다. 기본(log)은 메일 내용을 로그에 찍는다.
    # mail:
    #   mode: smtp
    #   from: 보내는_주소@gmail.com   # 비우면 spring.mail.username 을 쓴다

# Gmail 앱 비밀번호(16자리). 계정 비밀번호가 아니다.
# spring:
#   mail:
#     username: 보내는_주소@gmail.com
#     password: 앱_비밀번호

springdoc:
  # API 문서는 로컬에서만 연다. http://localhost:8080/swagger-ui.html
  api-docs:
    enabled: true
  swagger-ui:
    enabled: true
